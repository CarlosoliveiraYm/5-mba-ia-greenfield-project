# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Application URLs / docs
APP_URL=http://localhost:3000
SWAGGER_ENABLED=true

# Object storage (MinIO)
# S3_ENDPOINT is server-to-storage; S3_PUBLIC_ENDPOINT is what the browser can
# reach and is the host presigned delivery URLs are signed for.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamtube-videos
S3_ACCESS_KEY_ID=streamtube
S3_SECRET_ACCESS_KEY=streamtube
S3_FORCE_PATH_STYLE=true
PRESIGNED_URL_EXPIRATION_SECONDS=900
S3_CORS_ALLOW_ORIGIN=http://localhost:3001

# Background job queue (pg-boss)
QUEUE_SCHEMA=pgboss
QUEUE_RETRY_LIMIT=3
QUEUE_EXPIRE_IN_SECONDS=3600

# Uploads (tus / resumable)
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_ACCEPTED_CONTAINERS=mp4,mov,webm,mkv
UPLOAD_ACCEPTED_VIDEO_CODECS=h264,vp9,av1
UPLOAD_ABANDONED_EXPIRATION_HOURS=24
UPLOAD_TICKET_EXPIRATION_HOURS=2
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_PUBLIC_URL=http://localhost:3000/uploads

# FFmpeg
FFMPEG_TIMEOUT_SECONDS=3600

# Video worker
WORKER_SCRATCH_DIR=/tmp/streamtube
WORKER_CONCURRENCY=1

THUMBNAIL_OFFSET_PERCENT=10

UPLOAD_SWEEP_CRON=0 * * * *
